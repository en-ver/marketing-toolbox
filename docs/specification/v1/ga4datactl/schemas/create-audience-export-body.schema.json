{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-toolbox:ga4datactl:schema:create-audience-export-body.schema.json",
  "title": "GA4 Data API v1beta CreateAudienceExportRequest body",
