  "properties": {
    "audience": {
      "description": "The source audience resource name: properties/<property>/audiences/<audience>.",
      "type": "string"
    },
    "dimensions": {
      "description": "The requested audience-export user attributes.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimensionName": {
            "type": "string"
          }
        }
      }
    }
  }
}
